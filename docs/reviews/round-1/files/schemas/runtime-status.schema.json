{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runweft.invalid/schemas/scaffold-status",
  "title": "ScaffoldStatus",
  "description": "Offline provisional status contract; not a run API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "phase",
    "execution_enabled"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "product": {
      "type": "string",
      "const": "runweft"
    },
    "phase": {
      "type": "string",
      "const": "scaffold"
    },
    "execution_enabled": {
      "type": "boolean",
      "const": false
    }
  }
}
